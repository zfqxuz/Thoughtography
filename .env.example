# Choose the provider used by default: dsh | deepseek
THOUGHTOGRAPHY_PROVIDER=deepseek

# dsh / third-party relay. Set base URL to the OpenAI-compatible prefix,
# e.g. https://your-relay.example.com/v1
DSH_BASE_URL=
DSH_API_KEY=
DSH_VISION_MODEL=

# Official DeepSeek API
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_MODEL=

# Set to false if your provider rejects response_format={"type":"json_object"}
VISION_JSON_MODE=true
VISION_TIMEOUT_SEC=180
